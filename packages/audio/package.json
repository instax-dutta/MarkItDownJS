{
  "name": "@markitdownjs/audio",
  "version": "0.1.4",
  "description": "Audio file converter for MarkItDownJS",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@markitdownjs/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "keywords": [
    "audio",
    "converter",
    "document-conversion",
    "markdown",
    "markitdownjs",
    "metadata",
    "speech-to-text",
    "transcription",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
